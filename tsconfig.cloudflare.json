{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true
  },
  "include": [
    "cloudflare/**/*.ts",
    "netlify/lib/validation.mts",
    "netlify/lib/client-report.mts"
  ],
  "exclude": ["node_modules", "dist", ".work"]
}
