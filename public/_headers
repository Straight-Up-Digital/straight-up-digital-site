# Site-wide security headers for static asset responses.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000

# Long-lived immutable cache for fingerprinted Astro assets.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Long-lived cache for self-hosted fonts.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Weekly cache for brand images.
/brand/*
  Cache-Control: public, max-age=604800

# Netlify's /*.png policy applies to root-level PNG files. List current root assets
# explicitly because a greedy Cloudflare splat could also match nested images.
/app-icon-1024.png
  Cache-Control: public, max-age=604800
/apple-touch-icon.png
  Cache-Control: public, max-age=604800
/favicon-256.png
  Cache-Control: public, max-age=604800
/favicon-512.png
  Cache-Control: public, max-age=604800
/icon-192.png
  Cache-Control: public, max-age=604800
/icon-512.png
  Cache-Control: public, max-age=604800
/og-image.png
  Cache-Control: public, max-age=604800

# Netlify's /*.ico policy applies to the current root favicon.
/favicon.ico
  Cache-Control: public, max-age=604800
