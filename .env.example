# Copy to .env for local development. Never commit the real file.
# Production values live in Cloudflare: public values in wrangler.jsonc, secrets via `npx wrangler secret put NAME --env production`.

# Cloudflare Turnstile site key (public). When set, the challenge renders on the enquiry forms.
# The matching secret is TURNSTILE_SECRET_KEY and belongs in Cloudflare secrets.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Worker configuration (use .dev.vars for local Wrangler, never the browser) ---
# Values: zoho-mail-api | resend | postmark | zoho-smtp | console (console is local testing only)
EMAIL_PROVIDER=console
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
ZOHO_API_CLIENT_ID=
ZOHO_API_CLIENT_SECRET=
TURNSTILE_SECRET_KEY=
AUDIT_REPORTS_ENABLED=false
AUDIT_REPORT_PUBLISH_TOKEN=
