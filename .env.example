# Copy to .env for local development. Never commit the real file.
# On Netlify, set these under Project configuration > Environment variables.

# --- Build-time, public -------------------------------------------------------
# The site's canonical address. Leave empty locally; Netlify's URL variable is
# used automatically on deploys, including after a custom domain is connected.
PUBLIC_SITE_URL=

# Form delivery:
#   netlify = Netlify Forms (no third-party account, submissions in the Netlify UI)
#   email   = the Netlify Function validates and sends through the provider below
PUBLIC_FORM_MODE=netlify

# Cloudflare Turnstile site key. When set with PUBLIC_FORM_MODE=email, the
# challenge renders on the form. The matching secret belongs below.
PUBLIC_TURNSTILE_SITE_KEY=

# --- Function-only secrets (never exposed to the browser) ---------------------
# Required only when PUBLIC_FORM_MODE=email or online customer reports are enabled.
# Values: resend | postmark | zoho-smtp | console (console is local testing only)
EMAIL_PROVIDER=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
RESEND_API_KEY=
POSTMARK_SERVER_TOKEN=
POSTMARK_MESSAGE_STREAM=outbound
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USERNAME=straightupdigital@zohomail.com
ZOHO_SMTP_PASSWORD=
TURNSTILE_SECRET_KEY=

# Reports stay disabled until SMTP delivery is configured and tested.
AUDIT_REPORTS_ENABLED=false
AUDIT_REPORT_PUBLISH_TOKEN=
