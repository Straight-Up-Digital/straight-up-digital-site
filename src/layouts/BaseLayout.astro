---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import StickyAuditBar from "../components/StickyAuditBar.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import BackToTopButton from "../components/BackToTopButton.astro";
import { contact, ownerSupplied, site } from "../data/site";

interface Props {
  title: string;
  description: string;
  /** Path used for the canonical URL. Defaults to the current path. */
  canonicalPath?: string;
  noindex?: boolean;
  /** Hide the sticky mobile audit button on form pages. */
  showStickyAudit?: boolean;
  bodyClass?: string;
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  noindex = false,
  showStickyAudit = true,
  bodyClass = "",
  jsonLd = [],
} = Astro.props;

const siteUrl = Astro.site ?? new URL("http://localhost:4321");
const normalizedPath =
  canonicalPath === "/"
    ? "/"
    : canonicalPath.endsWith("/")
      ? canonicalPath
      : `${canonicalPath}/`;
const canonical = new URL(normalizedPath, siteUrl).toString();
const ogImage = new URL("/og-image.png", siteUrl).toString();

const pageTitle =
  title === site.name ? `${site.name} — ${site.tagline}` : `${title} | ${site.name}`;

const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: siteUrl.toString(),
  logo: new URL("/brand/logo-horizontal-dark.png", siteUrl).toString(),
  description: site.description,
  slogan: site.tagline,
  founder: { "@type": "Person", name: ownerSupplied.founderName },
  email: contact.email,
  telephone: contact.phoneInternational,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Port Alfred",
    addressRegion: "Eastern Cape",
    addressCountry: "ZA",
  },
};

const structuredData = [organization, ...jsonLd];
---

<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={ownerSupplied.founderName} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#080A09" />
    <meta name="color-scheme" content="dark light" />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_ZA" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      structuredData.map((data) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(data)}
        />
      ))
    }

    <noscript>
      <style>
        /* Without JavaScript the Core cannot open, so show the reading and
           remove the doors. Navigation remains available in the footer. */
        .core__reading { opacity: 1 !important; transition: none !important; }
        .core__door, .core__seam { opacity: 0 !important; }
        .nav-toggle { display: none !important; }
      </style>
    </noscript>
  </head>

  <body class:list={[bodyClass, showStickyAudit && "has-sticky-audit"]}>
    <a class="skip-link" href="#main">Skip to content</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    {showStickyAudit && <StickyAuditBar />}
    <div class="floating-actions" role="group" aria-label="Quick contact and navigation">
      <WhatsAppButton />
      <BackToTopButton />
    </div>
  </body>
</html>
