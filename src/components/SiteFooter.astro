---
import { footerNav } from "../data/navigation";
import { contact, ownerSupplied, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" aria-label="Straight Up Digital — home">
          <img
            src="/brand/logo-horizontal-dark.png"
            width="1800"
            height="440"
            alt="Straight Up Digital. Intelligence. Visibility. Growth."
          />
        </a>
        <p>{site.positioning}</p>
      </div>

      {
        footerNav.map((group) => (
          <div>
            <h2 class="site-footer__title">{group.title}</h2>
            <ul class="site-footer__list">
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>{item.shortLabel ?? item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="site-footer__grid site-footer__contact">
      <div>
        <h2 class="site-footer__title">Enquiries</h2>
        <p class="small">
          The enquiry form is the reliable route in. It is reviewed by a person,
          not an autoresponder.
        </p>
        <p style="margin-top: 12px;">
          <a class="link-arrow" href="/contact">
            Go to the enquiry form
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
        </p>
      </div>
      <div>
        <h2 class="site-footer__title">Direct details</h2>
        <p class="small">{ownerSupplied.legalEntity}</p>
        <p class="small">
          <a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
        <p class="small">
          <a class="text-link" href={`tel:${contact.phoneInternational.replace(/[^\d+]/g, "")}`}>{contact.phoneInternational}</a>
        </p>
        <p class="site-footer__note">{contact.address}</p>
      </div>
    </div>

    <p class="site-footer__legal">
      All digital audits are human-reviewed assessments of publicly visible information. Straight Up Digital does not guarantee search engine rankings, traffic volumes or financial returns. Services are governed by our Terms of Use and Privacy Notice under South African law, including POPIA.
    </p>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
