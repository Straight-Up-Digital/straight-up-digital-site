---
import { footerNav } from "../data/navigation";
import { contact, ownerSupplied, site, socialProfiles } from "../data/site";

const year = new Date().getFullYear();
const whatsappHref = `https://wa.me/${contact.phoneInternational.replace(/\D/g, "")}`;
const profileLinks = [
  { label: "LinkedIn", href: socialProfiles.linkedin },
  { label: "Facebook", href: socialProfiles.facebook },
  { label: "Instagram", href: socialProfiles.instagram },
].filter((link) => link.href);
---

<footer class="site-footer">
  <div class="container">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <a href="/" aria-label="Straight Up Digital home">
          <img
            src="/brand/logo-horizontal-dark.png"
            width="1680"
            height="500"
            alt="Straight Up Digital. Intelligence. Visibility. Growth."
          />
        </a>
        <p>{site.positioning}</p>
      </div>

      {
        footerNav.map((group) => (
          <div>
            <h2 class="site-footer__title">{group.title}</h2>
            <ul class="site-footer__list">
              {group.items.map((item) => (
                <li>
                  <a href={item.href}>{item.shortLabel ?? item.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="site-footer__grid site-footer__contact">
      <div>
        <h2 class="site-footer__title">Enquiries</h2>
        <p class="small">
          Tell us what your business needs. A person reviews the request and
          confirms the next step in writing.
        </p>
        <p style="margin-top: 12px;">
          <a class="link-arrow" href="/contact">
            Go to the enquiry form
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
        </p>
      </div>
      <div>
        <h2 class="site-footer__title">Direct details</h2>
        <p class="small">{ownerSupplied.legalEntity}</p>
        <p class="small">
          <a class="text-link" href={`mailto:${contact.email.toLowerCase()}`}>{contact.email.toLowerCase()}</a>
        </p>
        <p class="small">
          <a class="text-link" href={`tel:${contact.phoneInternational.replace(/[^\d+]/g, "")}`}>{contact.phoneInternational}</a>
        </p>
        <p class="site-footer__note">{contact.address}</p>
        <ul class="site-footer__social" aria-label="Contact Straight Up Digital">
          <li>
            <a href={whatsappHref} aria-label="Message Straight Up Digital on WhatsApp">
              <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M26.6 5.4A14.55 14.55 0 0 0 3.9 22.95L2 30l7.2-1.88A14.56 14.56 0 0 0 16.45 30h.01A14.56 14.56 0 0 0 26.6 5.4Z" fill="currentColor" /></svg>
            </a>
          </li>
          <li>
            <a href={`mailto:${contact.email.toLowerCase()}`} aria-label="Email Straight Up Digital">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="M3 7l9 6 9-6" /></svg>
            </a>
          </li>
          {profileLinks.map((link) => (
            <li class="site-footer__social-text"><a href={link.href} rel="noopener">{link.label}</a></li>
          ))}
        </ul>
      </div>
    </div>

    <p class="site-footer__legal">
      All digital audits are human-reviewed assessments of publicly visible information. Straight Up Digital does not guarantee search engine rankings, traffic volumes or financial returns. Services are governed by our Terms of Use, Privacy Notice, and Delivery, Cancellations and Refunds Policy under South African law, including POPIA.
    </p>

    <div class="site-footer__bottom">
      <p>© {year} {site.name}. All rights reserved.</p>
    </div>
  </div>
</footer>
