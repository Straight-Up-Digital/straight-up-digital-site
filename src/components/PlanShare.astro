---
interface Props {
  title: string;
  details: string;
  href: string;
}

const { title, details, href } = Astro.props;
if (!Astro.site) throw new Error("Set the public site origin before rendering plan shares.");
const planUrl = new URL(href, Astro.site).toString();
const shareText = `Straight Up Digital plan: ${title}. ${details} View plan details: ${planUrl}`;
const shareHref = `https://wa.me/?text=${encodeURIComponent(shareText)}`;
---

<a
  class="plan-share"
  href={shareHref}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Share ${title} on WhatsApp`}
  title={`Share ${title} on WhatsApp`}
>
  <svg viewBox="0 0 32 32" aria-hidden="true">
    <path d="M26.6 5.4A14.55 14.55 0 0 0 3.9 22.95L2 30l7.2-1.88A14.56 14.56 0 0 0 16.45 30h.01A14.56 14.56 0 0 0 26.6 5.4Z" fill="#25D366" />
    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2.1z" fill="#fff" transform="translate(5 5) scale(.69)" />
  </svg>
  <span>Share on WhatsApp</span>
</a>

<style>
  .plan-share {
    display: inline-flex;
    width: 100%;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 9px 14px;
    border: 1px solid rgba(37, 211, 102, 0.42);
    border-radius: 999px;
    background: rgba(37, 211, 102, 0.08);
    color: #075e54;
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
    transition: background-color var(--dur-fast) var(--ease-out), border-color var(--dur-fast) var(--ease-out), color var(--dur-fast) var(--ease-out);
  }

  .plan-share svg {
    width: 20px;
    height: 20px;
    flex: none;
  }

  .plan-share:hover {
    border-color: #25d366;
    background: #25d366;
    color: #052e16;
  }

  .plan-share:focus-visible {
    outline: 3px solid var(--lime);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .plan-share {
      transition: none;
    }
  }
</style>
