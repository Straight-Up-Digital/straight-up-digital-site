---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { hostingPlans, monthlyRetainers, websiteBuildPackages } from "../data/pricing";
import { websiteBuildHostingBundles, websiteHostingBundles } from "../data/bundles";
import { site } from "../data/site";

const description =
  "Fixed-scope websites, digital support and free human-reviewed business audits for small businesses across South Africa.";
const zar = (amount: number) => `R${amount.toLocaleString("en-ZA")}`;
const packageBySlug = (slug: string) => websiteBuildPackages.find((item) => item.slug === slug);
const starterPrice = packageBySlug("one-page-starter")!.priceZar;

const websiteBuildPrices = websiteBuildPackages.map((item) => item.priceZar);
const hostingMonthlyFrom = Math.min(...hostingPlans.map((plan) => plan.priceMonthlyZar));
const hostingAnnualFrom = Math.min(...hostingPlans.map((plan) => plan.priceAnnualZar));
const supportMonthlyFrom = Math.min(...monthlyRetainers.map((plan) => plan.priceZarPerMonth));
const supportMonthlyTo = Math.max(...monthlyRetainers.map((plan) => plan.priceZarPerMonth));
const allBundles = [...websiteHostingBundles, ...websiteBuildHostingBundles];
const firstYearBundleFrom = Math.min(...allBundles.map((bundle) => bundle.annual.priceZar));
const homeProductCards = [
  {
    number: "01",
    category: "WEBSITE BUILDS",
    title: "Fixed-price website packages",
    price: `${zar(Math.min(...websiteBuildPrices))} to ${zar(Math.max(...websiteBuildPrices))}`,
    cadence: "once-off",
    description: "Six clear scopes, from a one-page starter to a small online shop.",
    note: "Pay 50% to start and 50% at launch, after preview.",
    href: "/services/website-design-and-development#website-packages",
    action: "Compare all six builds",
  },
  {
    number: "02",
    category: "BUILD + EMAIL BUNDLES",
    title: "Website and business email",
    price: `From ${zar(firstYearBundleFrom)}`,
    cadence: "once-off, paid in full",
    description: "A discounted website build with the first year of a business email plan included.",
    note: `After year one, email hosting renews from ${zar(hostingAnnualFrom)} per year, recurring annually.`,
    href: "/bundles#bundle-packages",
    action: "Compare bundle offers",
  },
  {
    number: "03",
    category: "BUSINESS EMAIL + DOMAIN",
    title: "Professional email plans",
    price: `From ${zar(hostingMonthlyFrom)}`,
    cadence: "per month",
    description: "Business email with a managed .co.za domain and support for your team.",
    note: `Annual option: ${zar(hostingAnnualFrom)} per year, recurring annually.`,
    href: "/pricing#hosting-packages",
    action: "Compare email plans",
  },
  {
    number: "04",
    category: "ONGOING DIGITAL CARE",
    title: "Care and support plans",
    price: `From ${zar(supportMonthlyFrom)}`,
    cadence: `per month, up to ${zar(supportMonthlyTo)}`,
    description: "Five monthly service levels, from website care to a full digital desk.",
    note: "Review each plan's included work before you enquire.",
    href: "/pricing#support-packages",
    action: "Compare care plans",
  },
];

const solutionTiles = [
  {
    title: "Website design",
    image: "/images/art-directed/website-design.webp",
    alt: "A responsive website concept displayed on a desktop screen and phone.",
    detail: "Mobile-ready pages with clear customer contact routes.",
    price: `Packages from ${zar(starterPrice)} once-off`,
    href: "/services/website-design-and-development#website-packages",
  },
  {
    title: "Online shops",
    image: "/images/art-directed/online-shop.webp",
    alt: "A tablet showing a minimalist homeware catalogue beside ceramic objects and folded fabric.",
    detail: "A small catalogue, basic cart and orders by WhatsApp or email.",
    price: `${zar(packageBySlug("online-shop")!.priceZar)} once-off`,
    href: "/services/website-design-and-development#package-online-shop",
  },
  {
    title: "Guest houses & stays",
    image: "/images/art-directed/guest-house.webp",
    alt: "A light-filled guest room with a stone wall and a view across coastal greenery.",
    detail: "Rooms, facilities, location and links to an existing booking site.",
    price: `${zar(packageBySlug("guesthouse")!.priceZar)} once-off`,
    href: "/services/website-design-and-development#package-guesthouse",
  },
  {
    title: "Restaurants & cafés",
    image: "/images/art-directed/restaurant.webp",
    alt: "A plated restaurant dish with seafood, herbs and vegetables.",
    detail: "Menu, hours, map, gallery and a WhatsApp action.",
    price: `${zar(packageBySlug("restaurant-cafe")!.priceZar)} once-off`,
    href: "/services/website-design-and-development#package-restaurant-cafe",
  },
  {
    title: "Clinics & professionals",
    image: "/images/art-directed/clinic-practice.webp",
    alt: "A calm independent healthcare practice room with consultation seating and examination equipment.",
    detail: "Service information and contact or appointment routes, scoped to fit.",
    price: "Scoped and quoted on request",
    href: "/services/website-design-and-development#specialist-builds-title",
  },
];

const conceptCards = [
  {
    title: "Guest-stay information",
    category: "Accommodation concept",
    image: "/images/art-directed/guest-house.webp",
    alt: "An art-directed guest-room visual for an illustrative accommodation website concept.",
  },
  {
    title: "Menu and enquiries",
    category: "Restaurant concept",
    image: "/images/art-directed/restaurant.webp",
    alt: "An art-directed restaurant-dining visual for an illustrative website concept.",
  },
  {
    title: "Product catalogue",
    category: "Online-shop concept",
    image: "/images/art-directed/online-shop.webp",
    alt: "A homeware catalogue shown on a tablet for an illustrative online-shop concept.",
  },
  {
    title: "Practice information",
    category: "Professional-services concept",
    image: "/images/art-directed/clinic-practice.webp",
    alt: "A calm consultation room for an illustrative professional-practice website concept.",
  },
];
---

<BaseLayout title={site.name} description={description} canonicalPath="/">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="home-hero__eyebrow">Digital intelligence for small businesses</p>
        <h1 id="home-title"><span>Intelligence.</span><span>Visibility.</span><em>Growth.</em></h1>
        <p class="home-hero__sub">Smarter digital foundations for a stronger business.</p>
        <p class="home-hero__lede">
          Website builds, digital support and human-reviewed online audits for South African small businesses.
        </p>
        <div class="home-hero__actions">
          <a class="btn btn--primary" href="/digital-audit#request">Request your free business audit <span aria-hidden="true">→</span></a>
          <a class="btn btn--secondary" href="#products">Explore products and plans <span aria-hidden="true">↘</span></a>
        </div>
        <div class="home-hero__proof" aria-label="Straight Up Digital at a glance">
          <span>Fixed-scope website packages from {zar(starterPrice)}</span>
          <span>Human-reviewed business audits</span>
          <span>PROUDLY SOUTH AFRICAN</span>
        </div>
      </div>
      <figure class="home-hero__visual">
        <img class="home-hero__globe" src="/images/art-directed/africa-network-hero.webp" width="2816" height="1584" alt="Luminous globe with Africa at its centre, illuminated network connections and lime orbital arcs against a black background." fetchpriority="high" decoding="async" />
        <div class="hero-laptop" aria-hidden="true">
          <div class="hero-laptop__screen">
            <div class="hero-laptop__brand"><img src="/brand/symbol.svg" width="34" height="34" alt="" /><span>Straight Up Digital</span></div>
            <div class="hero-laptop__screen-copy"><strong>Intelligence.</strong><span>Visibility.</span><em>Growth.</em></div>
            <div class="hero-laptop__screen-line"><i></i><i></i><i></i></div>
          </div>
          <div class="hero-laptop__base"></div>
        </div>
        <figcaption class="home-hero__art-note">Original illustrative brand artwork</figcaption>
      </figure>
    </div>
  </section>

  <section class="section home-products" id="products" aria-labelledby="products-title">
    <div class="container">
      <div class="home-section-head">
        <div>
          <p class="kicker">Products and plans</p>
          <h2 id="products-title">Clear options for your next digital step.</h2>
        </div>
        <p>Compare fixed-price builds, discounted bundles, business email and ongoing support. Each card opens the exact package or plan details.</p>
      </div>
      <div class="home-product-grid">
        {homeProductCards.map((product) => (
          <a class="home-product-card" href={product.href}>
            <span class="home-product-card__eyebrow"><span>{product.number}</span> / {product.category}</span>
            <strong class="home-product-card__title">{product.title}</strong>
            <span class="home-product-card__price"><strong>{product.price}</strong><small>{product.cadence}</small></span>
            <span class="home-product-card__description">{product.description}</span>
            <span class="home-product-card__note">{product.note}</span>
            <span class="home-product-card__action">{product.action}<span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
      <p class="home-products__disclaimer">Buy now opens a no-charge order enquiry. Online checkout is not active, and no payment is taken here.</p>
    </div>
  </section>

  <section class="section home-solutions" id="website-packages" aria-labelledby="solutions-title">
    <div class="container">
      <div class="home-section-head">
        <div>
          <p class="kicker"><span>01</span> Website solutions</p>
          <h2 id="solutions-title">Choose a starting point built around your business.</h2>
        </div>
        <p>Explore the options that fit your work. Each package links to its exact scope; specialist features are discussed and quoted before work begins.</p>
      </div>
      <div class="home-solution-grid">
        {solutionTiles.map((tile, index) => (
          <a class="home-solution-tile" href={tile.href}>
            <img src={tile.image} width="1080" height="720" alt={tile.alt} loading="lazy" decoding="async" />
            <span class="home-solution-tile__shade" aria-hidden="true"></span>
            <span class="home-solution-tile__content">
              <span class="home-solution-tile__number">0{index + 1} / BUILD OPTIONS</span>
              <strong>{tile.title}</strong>
              <span class="home-solution-tile__detail">{tile.detail}</span>
              <span class="home-solution-tile__price">{tile.price}</span>
              <span class="home-solution-tile__link">Explore option <span aria-hidden="true">↗</span></span>
            </span>
          </a>
        ))}
      </div>
      <div class="home-package-rail" id="hosting-and-bundles">
        <div class="home-package-rail__copy">
          <strong>Clear package, clear next step.</strong>
          <span>Standalone builds are 50% to start and 50% at launch after preview. Discounted annual bundles are paid upfront and include the first hosting year.</span>
        </div>
        <a href="/services/website-design-and-development#website-packages">Compare all six website builds <span aria-hidden="true">↗</span></a>
        <a href="/bundles#bundle-packages">View website + hosting bundles <span aria-hidden="true">↗</span></a>
        <a href="/pricing#hosting-packages">Compare hosting plans <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

  <section class="section home-auditor-section" aria-labelledby="business-auditor-title">
    <div class="container">
      <div class="home-auditor-band">
        <div class="home-auditor-preview" aria-label="Illustrative report layout only; not a live audit or customer result">
          <div class="home-auditor-preview__top">
            <span class="home-auditor-preview__brand"><img src="/brand/symbol.svg" width="24" height="24" alt="" /> Business Auditor</span>
            <span class="home-auditor-preview__badge">Illustrative only</span>
          </div>
          <div class="home-auditor-preview__heading"><span>EXAMPLE REPORT LAYOUT</span><strong>Digital presence review</strong><small>No live business data shown</small></div>
          <div class="home-auditor-preview__rows" aria-hidden="true">
            <div><span>Website information</span><i>Evidence section</i></div>
            <div><span>Business details</span><i>Evidence section</i></div>
            <div><span>Contact routes</span><i>Evidence section</i></div>
            <div><span>Public visibility</span><i>Evidence section</i></div>
          </div>
          <div class="home-auditor-preview__foot">A person reviews what can be verified and identifies what remains uncertain.</div>
        </div>
        <div class="home-auditor-copy">
          <p class="kicker"><span>02</span> Business Auditor</p>
          <h2 id="business-auditor-title">See your online presence with fresh eyes.</h2>
          <p>Request a free, six-category business presence audit. A person reviews publicly visible information and shares evidence, confidence notes and practical next steps in a customer-ready report.</p>
          <p class="home-auditor-copy__truth">This is a request-and-human-review service. The website does not run an instant public audit, and no ranking, traffic or sales outcome is promised.</p>
          <div class="home-auditor__actions">
            <a class="btn btn--primary" href="/digital-audit#request">Request a free audit <span aria-hidden="true">→</span></a>
            <a class="text-link" href="/digital-audit#what-we-check">See what the review covers ↗</a>
          </div>
        </div>
        <ul class="home-auditor-points" aria-label="What the audit helps you do">
          <li><span aria-hidden="true">⌕</span><span><strong>Find gaps worth checking</strong><small>Evidence first, not guesswork.</small></span></li>
          <li><span aria-hidden="true">↗</span><span><strong>Prioritise practical next steps</strong><small>Clear recommendations in plain English.</small></span></li>
          <li><span aria-hidden="true">◎</span><span><strong>Talk it through with a person</strong><small>A human-reviewed report and walkthrough.</small></span></li>
        </ul>
      </div>
      <p class="home-auditor-disclaimer">The report graphic above is illustrative only. It contains no live customer data, scores or audit findings.</p>
    </div>
  </section>

  <section class="home-trust-strip" aria-label="How Straight Up Digital works">
    <div class="container home-trust-strip__inner">
      <div class="home-trust-strip__intro"><p class="kicker"><span>03</span> Straight answers</p><h2>Built on clear scope and honest advice.</h2></div>
      <div class="home-trust-item"><span class="home-trust-item__mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="4" width="14" height="17" rx="2"/><path d="M9 4h6v3H9zM9 14l2 2 4-4"/></svg></span><strong>Published package scope</strong><p>See what the stated price includes before you enquire.</p></div>
      <div class="home-trust-item"><span class="home-trust-item__mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6"/><path d="M20 20l-4.2-4.2M9 11l1.6 1.6L13.5 9.5"/></svg></span><strong>Human-reviewed audits</strong><p>Findings distinguish evidence from what could not be verified.</p></div>
      <div class="home-trust-item"><span class="home-trust-item__mark" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h8l4 4v14H7z"/><path d="M15 3v4h4M10 12h6M10 16h4"/></svg></span><strong>Written quote first</strong><p>Paid work starts only after the scope is agreed in writing.</p></div>
      <div class="home-trust-item">
        <span class="home-trust-item__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.3 2.4 3.4 5.4 3.4 9S14.3 18.6 12 21M12 3c-2.3 2.4-3.4 5.4-3.4 9s1.1 6.6 3.4 9"/></svg>
        </span>
        <strong>PROUDLY SOUTH AFRICAN</strong>
        <p>Online support for businesses across South Africa.</p>
      </div>
    </div>
  </section>

  <section class="section home-concepts" id="examples" aria-labelledby="concepts-title">
    <div class="container">
      <div class="home-section-head">
        <div>
          <p class="kicker"><span>04</span> Illustrative directions</p>
          <h2 id="concepts-title">Examples of what a clear business website can organise.</h2>
        </div>
        <p>These are demonstration directions, not client projects or case studies. The original generated imagery is illustrative; no customer work or business results are represented.</p>
      </div>
      <div class="home-concept-grid">
        {conceptCards.map((card) => (
          <article class="home-concept-card">
            <div class="home-concept-card__preview">
              <div class="home-concept-card__browser" aria-hidden="true"><i></i><i></i><i></i><span>Illustrative concept</span></div>
              <img src={card.image} width="1080" height="720" alt={card.alt} loading="lazy" decoding="async" />
              <span class="home-concept-card__label">Demonstration</span>
            </div>
            <div class="home-concept-card__copy"><span>{card.category}</span><h3>{card.title}</h3><p>Example content structure only. No customer work or performance result is represented.</p></div>
          </article>
        ))}
      </div>
      <p class="home-inline-note">Browse the fixed-scope builds and specialist website options <a href="/services/website-design-and-development#website-packages">on the website packages page</a>.</p>
    </div>
  </section>

  <div class="home-cta-shell">
    <CtaBand
      title="Ready to take a clearer next step?"
      body="Tell us what your business needs. We will review your enquiry, explain a suitable option and confirm the scope and price in writing before any paid work begins."
      primaryLabel="Request your free business audit"
      primaryHref="/digital-audit#request"
      secondaryLabel="View website packages"
      secondaryHref="/services/website-design-and-development#website-packages"
      caption="The audit is free and reviewed by a person. Website work is agreed and quoted separately."
    />
  </div>
</BaseLayout>
