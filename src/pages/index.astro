---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import { websiteBuildPackages, hostingPlans, hostingBillingNotice } from "../data/pricing";
import { services, serviceStatusMeta } from "../data/services";
import { site } from "../data/site";

const description =
  "Straight Up Digital helps small businesses make a clearer mark online with fixed-scope website packages, hosting options, annual bundles and human-reviewed digital presence audits.";
const zar = (amount: number) => `R${amount.toLocaleString("en-ZA")}`;
const industries = [
  { code: "01", name: "Restaurants & cafés", detail: "Menus, hours, maps and direct enquiry routes" },
  { code: "02", name: "Guest houses & tourism", detail: "Rooms, facilities, location and booking links" },
  { code: "03", name: "Bookings & appointments", detail: "Service information with one standard booking tool" },
  { code: "04", name: "Shops & local retail", detail: "Product discovery and a straightforward way to order" },
  { code: "05", name: "Trades & local services", detail: "Clear service pages and contact actions" },
  { code: "06", name: "Clinics & wellness", detail: "Practitioner details and patient-facing information" },
];
const featuredServices = services.filter((service) => [
  "digital-presence-audits",
  "website-design-and-development",
  "managed-hosting-and-domains",
].includes(service.slug));
---
<BaseLayout title={site.name} description={description} canonicalPath="/">
  <section class="home-hero" aria-labelledby="home-title">
    <div class="container home-hero__grid">
      <div class="home-hero__copy">
        <p class="home-hero__eyebrow">Digital intelligence for growing businesses</p>
        <h1 id="home-title">Make your next digital move <em>clear.</em></h1>
        <p class="home-hero__lede">
          Practical website packages, managed hosting and human-reviewed digital audits—explained in plain English, with scope and price made clear before work begins.
        </p>
        <div class="home-hero__actions">
          <a class="btn btn--primary" href="#website-packages">Explore website packages <span aria-hidden="true">↘</span></a>
          <a class="btn btn--secondary" href="/digital-audit">Meet Business Auditor <span aria-hidden="true">↗</span></a>
        </div>
        <div class="home-hero__proof" aria-label="Key information">
          <span>Website builds from R1,500 once-off</span>
          <span>Clear scope, written quote</span>
          <span>Port Alfred, Eastern Cape</span>
        </div>
      </div>
      <figure class="home-hero__visual">
        <img src="/illustrations/local-business-digital.svg" width="760" height="460" alt="Illustration of a local shop beside a sample digital dashboard. The dashboard is not live business data." fetchpriority="high" />
        <figcaption>Illustrative artwork only. The dashboard is not live data or a customer result.</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--flush" id="website-packages" aria-labelledby="packages-title">
    <div class="container" style="padding-top: var(--section);">
      <div class="home-section-head">
        <div>
          <p class="kicker"><span>01</span> Website solutions</p>
          <h2 id="packages-title">A practical starting point for the way you work.</h2>
        </div>
        <p>Choose a defined package for your business type. Each price covers the scope shown; anything extra is discussed and quoted separately.</p>
      </div>
      <div class="home-packages">
        {websiteBuildPackages.map((item) => (
          <a class="home-card" href={`/services/website-design-and-development#package-${item.slug}`}>
            <span class="home-card__tag">{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.summary}</p>
            <p class="home-card__price">{zar(item.priceZar)} <span>once-off</span></p>
            <span class="home-card__link"><span>See full scope · {item.pageCount}</span><span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
      <p class="home-inline-note">
        Standalone builds: 50% to start and 50% at launch after you have seen a preview. A discounted annual bundle is paid once-off and includes the build plus the first year of hosting; annual hosting renews after that included year. <a href="/bundles">Compare website + hosting bundles</a>.
      </p>
      <p class="home-inline-note">Payment note: online checkout is not active. We confirm scope, timing and payment arrangements in writing before an order begins.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="business-auditor-title">
    <div class="container home-auditor">
      <div class="home-auditor__copy">
        <p class="kicker"><span>02</span> Business Auditor</p>
        <h2 id="business-auditor-title">See your online presence with fresh eyes.</h2>
        <p>Business Auditor is our digital intelligence service. A person reviews publicly visible business information and shares practical findings in a customer-ready report. It is a request-and-review service; this website does not run an instant public audit.</p>
        <p>We state what could be checked, what remains uncertain and which improvements may be worth considering. No promised ranking, traffic figure or sales result.</p>
        <div class="home-auditor__actions">
          <a class="btn btn--primary" href="/digital-audit#request">Request a digital audit</a>
          <a class="btn btn--secondary" href="/digital-audit#what-we-check">What the review covers</a>
        </div>
      </div>
      <div>
        <div class="audit-mock" aria-label="Illustrative interface artwork only; not a live audit">
          <div class="audit-mock__bar">
            <div class="audit-mock__brand"><img src="/brand/symbol.svg" alt="" width="26" height="24" /><span>Business Auditor</span></div>
            <span class="audit-mock__badge">Illustrative view</span>
          </div>
          <div class="audit-mock__body" aria-hidden="true">
            <div class="audit-mock__dial"><span>Review<strong>Example only</strong></span></div>
            <div class="audit-mock__rows">
              <div class="audit-mock__row"><span>Website clarity</span><span>Example</span><div class="audit-mock__barline"><i style="--bar:72%"></i></div></div>
              <div class="audit-mock__row"><span>Business details</span><span>Example</span><div class="audit-mock__barline"><i style="--bar:56%"></i></div></div>
              <div class="audit-mock__row"><span>Local visibility</span><span>Example</span><div class="audit-mock__barline"><i style="--bar:83%"></i></div></div>
              <div class="audit-mock__row"><span>Contact routes</span><span>Example</span><div class="audit-mock__barline"><i style="--bar:64%"></i></div></div>
            </div>
          </div>
          <div class="audit-mock__foot">A person checks the evidence. Anything that cannot be verified is identified as such.</div>
        </div>
        <p class="audit-mock__disclaimer">Illustrative interface artwork only. Example labels and graphics are not live customer data or a real audit result.</p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="services-title">
    <div class="container">
      <div class="home-section-head">
        <div><p class="kicker"><span>03</span> Practical services</p><h2 id="services-title">Good digital work starts with the right next step.</h2></div>
        <p>See what is available now, what is scoped on request and what is still in development. We will not present planned work as an active service.</p>
      </div>
      <div class="home-services">
        {featuredServices.map((service, index) => (
          <a class="home-service" href={service.slug === "digital-presence-audits" ? "/digital-audit" : `/services#${service.slug}`}>
            <span class="home-service__number">0{index + 1} · {serviceStatusMeta[service.status].label}</span>
            <h3>{service.title}</h3>
            <p>{service.summary}</p>
            <span>Explore service <span aria-hidden="true">↗</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="hosting-and-bundles" aria-labelledby="hosting-title">
    <div class="container">
      <div class="home-section-head">
        <div><p class="kicker"><span>04</span> Hosting &amp; bundles</p><h2 id="hosting-title">Choose the plan that fits the way you work.</h2></div>
        <p>Website build, hosting, domain and support are different services. Review each scope and billing period before choosing what to request.</p>
      </div>
      <div class="home-packages">
        {hostingPlans.map((plan) => (
          <article class="home-card">
            <span class="home-card__tag">Hosting plan</span>
            <h3>{plan.name}</h3>
            <p>{plan.headline}</p>
            <p class="home-card__price">{zar(plan.priceMonthlyZar)} <span>/ month</span></p>
            <p>{zar(plan.priceAnnualZar)} per year. Annual plans recur annually; we confirm start date and first collection in writing.</p>
            <a class="home-card__link" href={`/contact?plan=${plan.slug}&billing=monthly#enquiry`}><span>Ask about this plan</span><span aria-hidden="true">↗</span></a>
          </article>
        ))}
      </div>
      <div class="home-inline-note">
        {hostingBillingNotice} <a href="/pricing#hosting-packages">View hosting, support and domain prices</a>.
      </div>
      <p class="home-inline-note"><strong>Need a domain only?</strong> Ask us to check registration or renewal options. <a href="/contact?plan=domain#enquiry">Request a domain quote</a>.</p>
      <div class="home-pricing-nav" style="margin-top: 28px;">
        <a href="/pricing#website-packages"><strong>Website packages</strong><span>Compare the six fixed-scope builds.</span><i>Explore ↗</i></a>
        <a href="/pricing#hosting-packages"><strong>Hosting plans</strong><span>Review monthly and annual hosting.</span><i>Explore ↗</i></a>
        <a href="/pricing#support-packages"><strong>Care &amp; support</strong><span>See available monthly support levels.</span><i>Explore ↗</i></a>
        <a href="/bundles#bundle-packages"><strong>Website + hosting bundles</strong><span>Build and first hosting year in one offer.</span><i>Explore ↗</i></a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="industries-title">
    <div class="container">
      <div class="home-section-head home-section-head--single">
        <div><p class="kicker"><span>05</span> Built around your business</p><h2 id="industries-title">Options for the work customers come to you for.</h2></div>
        <p>From a clear starter page to niche-focused packages, we shape the website around the information your customers need. More complex integrations are scoped and quoted separately.</p>
      </div>
      <div class="home-industries">
        {industries.map((industry) => (
          <article class="industry-card">
            <span class="industry-card__mark">{industry.code}</span>
            <div><h3>{industry.name}</h3><p>{industry.detail}</p></div>
          </article>
        ))}
      </div>
      <p class="home-inline-note">We do not claim to have built sites for these industries. These are example project types based on our published packages and request-only build options.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="working-title">
    <div class="container">
      <div class="home-section-head">
        <div><p class="kicker"><span>06</span> Straight answers</p><h2 id="working-title">Clear scope. Human review. No inflated promises.</h2></div>
        <p>Useful work is built on clear communication. Here is what you can expect from our process.</p>
      </div>
      <div class="home-benefits">
        <article class="home-benefit"><strong>Know what is included</strong><p>Package scope, revisions and third-party fees are shown before you commit.</p></article>
        <article class="home-benefit"><strong>See a preview</strong><p>Standalone website builds are split 50% to start and 50% at launch after preview.</p></article>
        <article class="home-benefit"><strong>Know what is verified</strong><p>Business Auditor notes the evidence checked and what could not be verified.</p></article>
        <article class="home-benefit"><strong>Keep expectations grounded</strong><p>No guaranteed rankings, traffic, enquiries or revenue claims.</p></article>
      </div>
      <p class="home-inline-note"><a href="/how-it-works">Read the full process</a> · <a href="/terms">Terms of use</a> · <a href="/policies">Delivery, cancellations and refunds</a></p>
    </div>
  </section>

  <CtaBand title="Ready for a clearer next step?" body="Tell us what your business needs. We will review your enquiry and reply with an appropriate option, scope and written quote before any paid work begins." />
</BaseLayout>
