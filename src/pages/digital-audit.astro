---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import FaqList from "../components/FaqList.astro";
import ClientReportPreview from "../components/ClientReportPreview.astro";
import { categories } from "../data/categories";
import { auditFaqs } from "../data/faqs";
import { contact, has } from "../data/site";

const description =
  "Request an owner-run digital presence review and receive a customer-ready report explaining what was found, why it matters, and what to fix.";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: auditFaqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer },
  })),
};

const serviceJsonLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: "Digital presence audit",
  serviceType: "Digital presence audit",
  description:
    "An owner-run review of public digital evidence. After review, the customer receives a customer-ready report explaining observed issues, their customer impact and practical fixes.",
  provider: { "@type": "Organization", name: "Straight Up Digital" },
};

const receive = [
  {
    title: "A customer-ready report",
    body: "A person checks the findings and shares a clear report that explains the evidence, confidence and practical next steps.",
  },
  {
    title: "What was actually found",
    body: "The report describes evidence in everyday language. If something could not be verified, it says so rather than guessing.",
  },
  {
    title: "Why it matters and what to fix",
    body: "Each customer-report finding explains how the issue may affect customers and gives you a practical next step.",
  },
  {
    title: "A clear next step",
    body: "Ask a question or discuss recommendations with us. Any paid work is scoped and priced separately.",
  },
];
---

<BaseLayout
  title="Digital audit"
  description={description}
  canonicalPath="/digital-audit"
  jsonLd={[serviceJsonLd, faqJsonLd]}
  showStickyAudit={false}
>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div>
        <p class="kicker">Business Auditor · Flagship product</p>
        <h1 class="page-hero__title">
          Know what your digital presence is doing, and what it is not.
        </h1>
        <div class="page-hero__actions">
          <a class="btn btn--primary" href="#request">
            Request your digital audit
            <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn--secondary" href="#what-we-check">See what is checked</a>
        </div>
      </div>
      <p class="page-hero__lede">
          Business Auditor is Straight Up Digital's flagship product. A person checks
          the business details and runs the full audit privately. After review, we
          share a customer-ready report explaining the real findings, why they matter
          and what to fix. This website does not run instant audits.
      </p>
    </div>
  </section>

  <section class="section" id="what-we-check" aria-labelledby="checks-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>01</span> The six categories</p>
          <h2 class="h2" id="checks-title" style="margin-top: 14px; max-width: 16ch;">
            What the audit investigates.
          </h2>
        </div>
        <p class="lede">
          Each category answers a question a customer would ask, in plain
          language. The checks below are the public signals used to answer it.
        </p>
      </div>

      <div class="audit-table">
        {
          categories.map((category, index) => (
            <article class="audit-row" id={category.id}>
              <div class="audit-row__index">{String(index + 1).padStart(2, "0")}</div>
              <div>
                <h3 class="h3">{category.name}</h3>
                <p class="audit-row__question">{category.question}</p>
                <p class="audit-row__summary">{category.summary}</p>
              </div>
              <ul class="checks">
                {category.checks.map((check) => <li>{check}</li>)}
              </ul>
            </article>
          ))
        }
      </div>

      <p style="margin-top: 32px;">
        <a class="btn btn--primary" href="#request">
          Request your digital audit
          <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
        </a>
      </p>
    </div>
  </section>

  <section class="section" id="scoring" aria-labelledby="scoring-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>02</span> How the review works</p>
          <h2 class="h2" id="scoring-title" style="margin-top: 14px; max-width: 14ch;">
            Evidence first. Plain language next.
          </h2>
        </div>
        <p class="lede">
          The private Business Auditor uses structured checks to assess what could
          be verified. Your report focuses on the actual findings and
          practical fixes, not an internal scorecard.
        </p>
      </div>

      <div class="score-grid">
        <div class="score-grid__cell">
          <h3>Evidence, not assumptions</h3>
          <p>
            Recommendations are based on public information checked for your
            business. The report separates confirmed observations from items that
            need a manual check.
          </p>
        </div>
        <div class="score-grid__cell">
          <h3>Unknown stays unknown</h3>
          <p>
            If a listing, review, or website detail cannot be matched confidently,
            it is not presented as fact and is not treated as proof that it does
            not exist.
          </p>
        </div>
        <div class="score-grid__cell">
          <h3>No ranking promises</h3>
          <p>
            The review does not measure sales, website traffic, search volume or
            live Google rankings. It does not promise leads or ranking gains.
          </p>
        </div>
      </div>

      <div class="example-reading" style="grid-template-columns: minmax(0, 1fr);">
        <div class="example-reading__meta">
          <span class="example-tag">Customer view</span>
          <h3>A report you can act on</h3>
          <p>
            The private audit and detailed scorecard stay with Straight Up Digital.
            Your report gives you the findings that matter: what was observed, why
            it may affect customers, and a clear first fix.
          </p>
          <p>No PDF download, confusing jargon or promise of guaranteed results.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="example-report" aria-labelledby="report-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>03</span> The report</p>
          <h2 class="h2" id="report-title" style="margin-top: 14px;">
            A sample customer report.
          </h2>
        </div>
        <p class="lede">
          This fictional example shows how an audit finding is translated into a
          clear explanation and practical fix. It is not a real business review.
        </p>
      </div>

      <ClientReportPreview />

      <p style="margin-top: 32px;">
        <a class="btn btn--primary" href="#request">
          Request your digital audit
          <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
        </a>
      </p>
    </div>
  </section>

  <section class="section" id="what-you-receive" aria-labelledby="receive-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>04</span> What you receive</p>
          <h2 class="h2" id="receive-title" style="margin-top: 14px; max-width: 14ch;">
            A clear report and a useful next step.
          </h2>
        </div>
        <p class="lede">
          Once a person has run and reviewed your audit, we share the report and
          discuss a practical next step with you.
        </p>
      </div>

      <div class="factor-grid">
        {
          receive.map((item) => (
            <article class="factor">
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </article>
          ))
        }
      </div>

      <div class="limits" style="margin-top: 40px;">
        <h3>The limits, in plain words</h3>
        <ul>
          <li>
            The audit is directional. It does not measure traffic, search volume,
            revenue or conversions.
          </li>
          <li>
            It does not guarantee rankings, enquiries or sales, and it does not
            imply any affiliation with Google or another platform.
          </li>
          <li>
            It reflects public information at the time of the audit. Profiles and
            search results change.
          </li>
          <li>
            It is not legal, financial or accounting advice, and it does not
            replace your own analytics.
          </li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section" id="request" aria-labelledby="request-title">
    <div class="container contact-layout">
      <EnquiryForm
        variant="audit"
        heading="Request your digital audit"
        intro="Send your business details and a short note. A person will verify the information and run the full audit privately; if suitable, we will share a clear customer-ready report with you."
        submitLabel="Send my audit request"
      />

      <aside class="contact-aside">
        <div class="info-panel">
          <h3>What happens next</h3>
          <ol>
            <li>A person checks the business details and runs the full audit privately.</li>
            <li>You receive a customer-ready report explaining the findings, impact and fixes.</li>
            <li>Ask a question or arrange a discussion with us. Paid work is agreed separately in writing.</li>
          </ol>
        </div>
        <div class="info-panel">
          <h3>What to include</h3>
          <p>
            The website address and a sentence about what is not working. If you
            do not have a website, say so. That is part of the picture.
          </p>
        </div>
        {has(contact.email) && (
          <div class="info-panel">
            <h3>Prefer email?</h3>
            <p><a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a></p>
          </div>
        )}
      </aside>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container container--narrow">
      <div class="section-head" style="grid-template-columns: 1fr;">
        <div>
          <p class="kicker"><span>05</span> Questions</p>
          <h2 class="h2" id="faq-title" style="margin-top: 14px;">
            The things people ask first.
          </h2>
        </div>
      </div>
      <FaqList items={auditFaqs} />
    </div>
  </section>
</BaseLayout>
