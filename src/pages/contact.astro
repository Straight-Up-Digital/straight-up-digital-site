---
import BaseLayout from "../layouts/BaseLayout.astro";
import EnquiryForm from "../components/EnquiryForm.astro";
import { contact, has, placeholderKeys, site } from "../data/site";

const description =
  "Contact Straight Up Digital. Tell us what is not working, send the website address, and a person will reply with a clear next step. Audit requests, projects and questions all start here.";

const details = [
  { key: "email", label: "Email", value: contact.email, href: `mailto:${contact.email}` },
  { key: "phone", label: "Phone", value: contact.phone, href: `tel:${contact.phone.replace(/\s+/g, "")}` },
  { key: "address", label: "Address", value: contact.address, href: "" },
] as const;
---

<BaseLayout
  title="Contact"
  description={description}
  canonicalPath="/contact"
  showStickyAudit={false}
>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div>
        <p class="kicker">Contact</p>
        <h1 class="page-hero__title">
          Tell us what is not working.
        </h1>
      </div>
      <p class="page-hero__lede">
        A sentence is enough to start. If you already know the website address,
        include it — we will look before we reply.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="container contact-layout">
      <EnquiryForm
        variant="contact"
        id="enquiry"
        heading="Send an enquiry"
        intro="Use this form for an audit request, a project question or a quote. If something is missing or does not look right, the field will say so in plain words."
        submitLabel="Send my enquiry"
      />

      <aside class="contact-aside">
        <div class="info-panel">
          <h2 class="h3" style="margin-bottom: 12px;">What happens next</h2>
          <ol>
            <li>A person reads it and checks the public details.</li>
            <li>We reply with a clear next step or a question we need answered.</li>
            <li>If work is involved, the scope, cost and timing arrive in writing.</li>
          </ol>
        </div>

        <div class="info-panel">
          <h3>Direct details</h3>
          {
            details.map((detail) =>
              has(detail.value) ? (
                <p style="margin-bottom: 8px;">
                  <span class="caption">{detail.label}</span><br />
                  {detail.href ? (
                    <a class="text-link" href={detail.href}>{detail.value}</a>
                  ) : (
                    detail.value
                  )}
                </p>
              ) : null,
            )
          }
          {
            !has(contact.email) && !has(contact.phone) && !has(contact.address) && (
              <p class="small" data-placeholder={placeholderKeys.email}>
                A direct email address and phone number will appear here shortly.
                Until then, this form is the reliable route and it reaches the
                same inbox.
              </p>
            )
          }
        </div>

        <div class="info-panel">
          <h3>Please do not send</h3>
          <p>
            ID numbers, card details, passwords or anything you would not want in
            an email. The form only needs enough to understand the request.
          </p>
        </div>

        <div class="info-panel">
          <h3>Privacy</h3>
          <p>
            These details are used to respond to your enquiry. Read the{" "}
            <a class="text-link" href="/privacy">privacy notice</a> for what is
            collected, why, and how to ask for it to be removed.
          </p>
          <p class="caption" style="margin-top: 10px;">
            {site.name} · Enquiries are read by a person, not an autoresponder.
          </p>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
