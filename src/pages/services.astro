---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import {
  services,
  serviceStatusMeta,
  type ServiceStatus,
} from "../data/services";

const description =
  "Explore Straight Up Digital services, hosting plans and specialist website builds for South African small businesses. Open a service card for clear details and next steps.";

const statuses: ServiceStatus[] = ["available", "on-request", "planned"];

const serviceJsonLd = services.map((service) => ({
  "@context": "https://schema.org",
  "@type": "Service",
  name: service.title,
  description: service.summary,
  serviceType: service.title,
  provider: {
    "@type": "Organization",
    name: "Straight Up Digital",
  },
}));
---

<BaseLayout
  title="Services"
  description={description}
  canonicalPath="/services"
  jsonLd={serviceJsonLd}
>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div>
        <p class="kicker"><span>Services</span></p>
        <h1 class="page-hero__title">
          Six ways to make the presence work harder.
        </h1>
        <div class="page-hero__actions">
          <a class="btn btn--primary" href="/digital-audit#request">
            Request your digital audit
            <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn--secondary" href="#digital-presence-audits">Start with the audit</a>
        </div>
      </div>
      <p class="page-hero__lede">
        Everything starts with the audit. After that you choose the work that is
        worth doing. Nothing here is labelled available unless it is.
      </p>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="status-title">
    <div class="container">
      <h2 class="visually-hidden" id="status-title">How service statuses work</h2>
      <div class="status-legend">
        {
          statuses.map((status) => (
            <div class="status-legend__item">
              <span class:list={["status", `status--${status}`]}>
                {serviceStatusMeta[status].label}
              </span>
              <p>{serviceStatusMeta[status].description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section ivory" aria-labelledby="service-catalog-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>01</span> Choose a service</p>
          <h2 class="h2" id="service-catalog-title" style="margin-top: 14px;">Start with the work you need.</h2>
        </div>
        <p class="body">Select a card to open a full service page. It explains who the service is for, what is included and how to take the next step.</p>
      </div>

      <div class="service-catalog" aria-label="Service options">
        {
        services.map((service) => (
            <a id={service.slug} class="service-catalog__card" href={`/services/${service.slug}`}>
              <span class:list={["status", `status--${service.status}`]}>
                {serviceStatusMeta[service.status].label}
              </span>
              <h3>{service.title}</h3>
              <p>{service.summary}</p>
              <span class="service-catalog__link">Read service details <span aria-hidden="true">→</span></span>
            </a>
          ))
        }
        <a class="service-catalog__card service-catalog__card--feature" href="/pricing#monthly-support">
          <span class="pricing-label">Monthly support plans</span>
          <h3>Monthly support plans</h3>
          <p>Compare the existing support levels, what each includes and its monthly price.</p>
          <span class="service-catalog__link">See monthly plans <span aria-hidden="true">→</span></span>
        </a>
        <a class="service-catalog__card service-catalog__card--feature" href="/pricing#hosting-packages">
          <span class="pricing-label">Hosting plans</span>
          <h3>Choose email and domain support</h3>
          <p>Compare mailbox, storage and domain options, with monthly and annual request choices.</p>
          <span class="service-catalog__link">Compare hosting plans <span aria-hidden="true">→</span></span>
        </a>
      </div>
    </div>
  </section>

  <CtaBand
    title="Not sure which service you need?"
    body="That is what the audit is for. It shows what is actually holding the presence back, so the next step is based on evidence rather than guesswork."
    secondaryLabel="See how the audit works"
    secondaryHref="/digital-audit"
  />
</BaseLayout>

<script>
  const links = Array.from(
    document.querySelectorAll<HTMLAnchorElement>("[data-service-link]"),
  );
  const sections = links
    .map((link) => document.getElementById(link.dataset.serviceLink ?? ""))
    .filter((section): section is HTMLElement => Boolean(section));

  if (sections.length > 0 && "IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          links.forEach((link) => {
            const isCurrent = link.dataset.serviceLink === entry.target.id;
            if (isCurrent) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
          });
        });
      },
      { rootMargin: "-30% 0px -60% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
  }
</script>
