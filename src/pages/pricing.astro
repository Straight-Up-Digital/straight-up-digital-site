---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import {
  auditFixPackage,
  auditPricing,
  costFactors,
  domainOffer,
  hostingAddOns,
  hourlyPricing,
  hostingBillingNotice,
  hostingPlans,
  monthlyRetainers,
  onceOffEdits,
  pricingPrinciples,
  websiteBuildDeliverables,
  websiteBuildPackages,
  websiteOffer,
} from "../data/pricing";
import { pricingFaqs } from "../data/faqs";

const description =
  "Compare Straight Up Digital website package prices, hosting bundles, free digital audits, score-based fixes and monthly support for Eastern Cape businesses.";
const formatZar = (amount: number): string =>
  `R${amount.toLocaleString("en-US")}`;
const exampleScore = 70;
const exampleFixPrice =
  Math.max(0, auditPricing.maximumScore - exampleScore) *
  auditFixPackage.pricePerMissingPointZar;
---

<BaseLayout
  title="Pricing"
  description={description}
  canonicalPath="/pricing"
>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div>
        <p class="kicker">Pricing</p>
        <h1 class="page-hero__title">
          Clear scope. Written quotes. No surprise invoices.
        </h1>
        <div class="page-hero__actions">
          <a class="btn btn--primary" href="/contact">
            Get a quote
            <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn--secondary" href="#hosting-packages">See hosting plans</a>
        </div>
      </div>
      <p class="page-hero__lede">
        Choose a clear starting point: a free audit, one-off website work,
        monthly hosting or a growth retainer. Pick monthly billing or annual
        recurring hosting; we confirm your order and payment schedule in writing before you choose a payment method.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>01</span> How pricing works</p>
          <h2 class="h2" id="principles-title" style="margin-top: 14px; max-width: 14ch;">
            Three rules, every time.
          </h2>
        </div>
        <p class="lede">
          The quote is not a sales document. It is the agreement about what will
          be done, what it costs and when it will be finished.
        </p>
      </div>

      <div class="pricing-principles">
        {
          pricingPrinciples.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="factors-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>02</span> What affects cost</p>
          <h2 class="h2" id="factors-title" style="margin-top: 14px; max-width: 14ch;">
            Six things change the number.
          </h2>
        </div>
        <p class="lede">
          None of them are secrets. Knowing them in advance is why the quote can
          be fixed rather than “estimated”.
        </p>
      </div>

      <div class="factor-grid">
        {
          costFactors.map((factor) => (
            <article class="factor">
              <h3>{factor.title}</h3>
              <p>{factor.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section ivory" id="packages" aria-labelledby="packages-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>03</span> Packages at a glance</p>
          <h2 class="h2" id="packages-title" style="margin-top: 14px;">
            A clear place to start.
          </h2>
        </div>
        <p class="body">
          Audit and website-service rates mirror the existing proposal settings;
          hosting is a separate reseller offer. A written quote confirms scope.
        </p>
      </div>

      <div class="pricing-overview">
        <article class="pricing-overview__card">
          <p class="pricing-label">Business Auditor · human-reviewed audit</p>
          <p class="pricing-overview__price">Free<span> six-category audit</span></p>
          <p>Start with an honest scorecard, evidence and a prioritised action plan.</p>
          <p><strong>{formatZar(auditPricing.pricePerMissingPointZar)} per verified missing point</strong> for optional fixes. Example: {exampleScore}/100 means {auditPricing.maximumScore - exampleScore} points × {formatZar(auditFixPackage.pricePerMissingPointZar)} = {formatZar(exampleFixPrice)} once-off.</p>
          <a class="link-arrow" href="/digital-audit#request">
            Get your free audit
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
        </article>
        <article class="pricing-overview__card">
          <p class="pricing-label">Website packages</p>
          <p class="pricing-overview__price">{formatZar(websiteOffer.buildOnceOffZar)}<span> once-off</span></p>
          <p>Compare six fixed-price packages: R1,500, R3,500, R3,950, R4,500, R5,500 and R7,500, each for its listed scope.</p>
          <p>Standalone builds have separate hosting from {formatZar(websiteOffer.hostingMonthlyZar)}/month. Discounted annual bundles include the first hosting year.</p>
          <p>Standalone builds: 50% to start and 50% at launch after preview. Discounted annual bundles are paid in full and include the first hosting year; annual hosting renews after that year.</p>
          <a class="link-arrow" href="#website-build-packages">Compare website packages</a>
        </article>
        <article class="pricing-overview__card">
          <p class="pricing-label">Hosting and domain</p>
          <p class="pricing-overview__price">From {formatZar(websiteOffer.hostingMonthlyZar)}<span> / month</span></p>
          <p>All three plans include a managed .co.za domain, with monthly or annual billing.</p>
          <a class="link-arrow" href="#hosting-packages">Compare hosting plans</a>
        </article>
        <article class="pricing-overview__card">
          <p class="pricing-label">Once-off audit fixes</p>
          <p class="pricing-overview__price">{formatZar(auditFixPackage.pricePerMissingPointZar)}<span> per missing point</span></p>
          <p>Target the real gaps from your free audit, then see the improvement in a re-score.</p>
          <a class="link-arrow" href="/digital-audit#request">Start with the free audit</a>
        </article>
        <article class="pricing-overview__card">
          <p class="pricing-label">Additional specialist work</p>
          <p class="pricing-overview__price">{formatZar(hourlyPricing.rateZar)}<span> / hour</span></p>
          <p>Hourly work is scoped in writing, with a {hourlyPricing.minimumEstimateHours}-hour minimum estimate before you decide.</p>
          <a class="link-arrow" href="/contact">Ask for a written scope</a>
        </article>
      </div>

      <div class="pricing-subsection" id="website-build-packages" aria-labelledby="website-build-packages-title">
        <div class="section-head">
          <div>
            <p class="kicker"><span>04</span> Website builds</p>
            <h3 class="h2" id="website-build-packages-title" style="margin-top: 14px;">Choose the size and features you need.</h3>
          </div>
          <p class="body">
            Each package has a fixed once-off price for its listed scope. Standalone
            website builds are paid 50% to start and 50% at launch, after you have
            seen a preview. Discounted annual bundles are paid in full once-off
            and include the build plus the first year of hosting.
          </p>
        </div>
        <div class="package-grid package-grid--retainers">
          {websiteBuildPackages.map((websitePackage) => (
            <article class:list={["package-slot", "package-slot--retainer", "hosting-card", websitePackage.slug === "five-page-business" && "hosting-card--featured"]}>
              {websitePackage.slug === "five-page-business" && <span class="package-badge">Popular choice</span>}
              <p class="pricing-label">{websitePackage.label}</p>
              <h3>{websitePackage.title}</h3>
              <p class="package-slot__price">{websitePackage.priceIsFrom ? "From " : ""}{formatZar(websitePackage.priceZar)}<span> once-off</span></p>
              <p class="hosting-card__best-for"><strong>Standalone payment:</strong> 50% to start and 50% at launch after preview.</p>
              <p class="hosting-card__best-for"><strong>{websitePackage.pageCount}.</strong> {websitePackage.bestFor}</p>
              <p>{websitePackage.summary}</p>
              <div class="package-actions">
                <a class="btn btn--primary btn--on-ivory" href={`/services/website-design-and-development#package-${websitePackage.slug}`}>See included scope</a>
                <a class="link-arrow" href={websitePackage.slug === "one-page-starter" ? "/bundles#bundle-packages" : `/bundles#bundle-build-${websitePackage.slug}`}>See hosting bundle</a>
              </div>
            </article>
          ))}
        </div>
        <p class="pricing-guardrail" style="margin-top: 24px;">
          Standalone build prices are once-off and fixed for the listed scope. Pay
          50% to start and 50% at launch; we show you a preview before collecting
          the balance. Discounted annual bundles are a separate offer: the full
          bundle price is paid once-off, includes the first year of hosting, and
          annual renewal begins after that year. Every order is confirmed in
          writing before work starts. Online checkout is not active.
        </p>
      </div>

      <div class="pricing-subsection">
        <div class="section-head">
          <div>
          <p class="kicker"><span>05</span> Fix what matters</p>
            <h3 class="h2" style="margin-top: 14px;">Only pay for the gaps your audit actually finds.</h3>
          </div>
          <p class="body">
            Your free score gives us the starting point. We confirm every fix and
            its price with you before any work begins.
          </p>
        </div>
        <div class="pricing-overview">
          <article class="pricing-overview__card">
            <p class="pricing-label">{auditFixPackage.name} · once-off</p>
            <p class="pricing-overview__price">{formatZar(auditFixPackage.pricePerMissingPointZar)}<span> per missing point</span></p>
            <p>{auditFixPackage.description}</p>
            <ul class="package-includes">
              {auditFixPackage.deliverables.map((item) => <li>{item}</li>)}
            </ul>
            <a class="link-arrow" href="/digital-audit#request">Get the free scorecard first</a>
        </article>
        <article class="pricing-overview__card">
          <p class="pricing-label">One-page starter website · once-off</p>
          <p class="pricing-overview__price">{formatZar(websiteOffer.buildOnceOffZar)}<span> once-off</span></p>
          <p>A mobile-ready one-page website. Compare the five-page and specialist packages above.</p>
            <ul class="package-includes">
              {websiteBuildDeliverables.map((item) => <li>{item}</li>)}
            </ul>
            <p>Requires a hosting plan from {formatZar(websiteOffer.hostingMonthlyZar)}/month.</p>
            <a class="link-arrow" href="/contact?plan=website-one-page-starter&billing=once-off#enquiry">Request the one-page starter</a>
          </article>
        </div>
      </div>

      <div class="pricing-subsection" id="hosting-packages" aria-labelledby="hosting-packages-title">
        <div class="section-head">
          <div>
          <p class="kicker"><span>06</span> Hosting &amp; domains</p>
            <h3 class="h2" id="hosting-packages-title" style="margin-top: 14px;">A professional home for your business email.</h3>
          </div>
          <p class="body">
            Each tier includes domain registration and renewal, clear mailbox and
            storage allowances, and a choice of monthly or annual recurring
            billing. Annual pricing is equivalent to two months free.
          </p>
        </div>
        <div class="package-grid package-grid--retainers">
          {hostingPlans.map((plan) => (
            <article class:list={["package-slot", "package-slot--retainer", "hosting-card", plan.featured && "hosting-card--featured"]}>
              {plan.featured && <span class="package-badge">Most popular</span>}
              <img class="package-icon" src="/brand/symbol.svg" alt="" width="42" height="34" loading="lazy" />
              <p class="pricing-label">Hosting plan</p>
              <h3>{plan.name}</h3>
              <p class="hosting-card__headline">{plan.headline}</p>
              <p class="hosting-card__best-for"><strong>Best for:</strong> {plan.bestFor}</p>
              <p class="package-slot__price">{formatZar(plan.priceMonthlyZar)}<span> / month</span></p>
              <p class="hosting-card__annual">{formatZar(plan.priceAnnualZar)} / year <strong>· recurring annually · 2 months free</strong></p>
              <h4>What you get</h4>
              <ul class="package-includes">
                {plan.whatYouGet.map((item) => <li>{item}</li>)}
              </ul>
              <details class="hosting-card__details">
                <summary>Included technical features</summary>
                <ul class="package-includes">
                  {plan.technicalFeatures.map((item) => <li>{item}</li>)}
                </ul>
              </details>
              <div class="package-actions">
                <a class="btn btn--primary btn--on-ivory" href={`/contact?plan=${plan.slug}&billing=monthly#enquiry`}>Request monthly</a>
                <a class="link-arrow" href={`/contact?plan=${plan.slug}&billing=annual#enquiry`}>Ask about annual recurring billing</a>
              </div>
            </article>
          ))}
        </div>
        <p class="pricing-guardrail" style="margin-top: 24px;">
          <strong>Need another extension?</strong> Additional domains start from {formatZar(domainOffer.additionalExtensionsFromZar)} {domainOffer.billing}. {domainOffer.note} <a class="text-link" href="/contact?plan=domain#enquiry">Ask about an extra domain</a>.
        </p>
        <p class="pricing-guardrail">{hostingBillingNotice}</p>
      </div>

      <div class="pricing-subsection" id="monthly-support">
        <div class="section-head">
          <div>
          <p class="kicker"><span>07</span> Monthly support</p>
            <h3 class="h2" style="margin-top: 14px;">Consistent growth, without a big-agency contract.</h3>
          </div>
          <p class="body">
            Hosting is included in every retainer below. One monthly bill covers
            the listed plan and the agreed work—no duplicate hosting charge.
          </p>
        </div>
        <div class="package-grid package-grid--retainers">
          {monthlyRetainers.map((plan) => (
            <article class:list={["package-slot", "package-slot--retainer", "retainer-card", plan.featured && "hosting-card--featured"]}>
              {plan.featured && <span class="package-badge">Most popular</span>}
              <p class="pricing-label">Level {plan.level} · Monthly retainer</p>
              <h3>{plan.name}</h3>
              <p class="retainer-card__headline">{plan.headline}</p>
              <p class="retainer-card__best-for"><strong>Best for:</strong> {plan.bestFor}</p>
              <p class="package-slot__price">{formatZar(plan.priceZarPerMonth)}<span> / month</span></p>
              <p class="retainer-card__hosting"><strong>Hosting included:</strong> {plan.includedHosting}</p>
              <h4>What you get</h4>
              <ul class="package-includes">
                {plan.whatYouGet.map((item) => <li>{item}</li>)}
              </ul>
              <details class="hosting-card__details">
                <summary>See included deliverables</summary>
                <ul class="package-includes">
                  {plan.deliverables.map((item) => <li>{item}</li>)}
                </ul>
              </details>
              <a class="btn btn--primary btn--on-ivory" href={`/contact?plan=retainer-level-${plan.level}&billing=monthly#enquiry`}>Ask about Level {plan.level}</a>
            </article>
          ))}
        </div>
      </div>

      <div class="pricing-subsection">
        <div class="section-head">
          <div>
          <p class="kicker"><span>08</span> Once-off edits</p>
            <h3 class="h2" style="margin-top: 14px;">Small changes, fixed prices.</h3>
          </div>
          <p class="body">Available to clients on a hosting plan. Ask for the change and approve the amount before work starts.</p>
        </div>
        <div class="edit-rate-grid">
          {onceOffEdits.map((item) => (
            <article class="edit-rate">
              <h4>{item.title}</h4>
              <p>{formatZar(item.priceZar)}</p>
              <a class="link-arrow" href={`/contact?plan=${item.slug}&billing=once-off#enquiry`}>Request this edit</a>
            </article>
          ))}
        </div>
      </div>

      <div class="pricing-subsection">
        <div class="section-head">
          <div>
          <p class="kicker"><span>09</span> Optional add-ons</p>
            <h3 class="h2" style="margin-top: 14px;">Add only what you need.</h3>
          </div>
        </div>
        <div class="edit-rate-grid">
          {hostingAddOns.map((item) => (
            <article class="edit-rate">
              <h4>{item.name}</h4>
              <p>{item.price}<span> · {item.billing}</span></p>
              <a class="link-arrow" href={`/contact?plan=${item.name === "Email migration" ? "email-migration" : item.name === "Extra 10 GB storage" ? "extra-storage" : "domain"}#enquiry`}>Ask about this add-on</a>
            </article>
          ))}
        </div>
      </div>

      <p class="pricing-guardrail">
        {websiteOffer.guardrail}
      </p>

      <p style="margin-top: 32px;">
        <a class="btn btn--primary btn--on-ivory" href="/contact">
          Discuss your scope
          <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
        </a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="pricing-faq-title">
    <div class="container container--narrow">
      <div class="section-head" style="grid-template-columns: 1fr;">
        <div>
          <p class="kicker"><span>10</span> Questions</p>
          <h2 class="h2" id="pricing-faq-title" style="margin-top: 14px;">
            Before you ask for a quote.
          </h2>
        </div>
      </div>
      <FaqList items={pricingFaqs} />
    </div>
  </section>

  <CtaBand
    title="Tell us the scope. We will put a number on it."
    body="Choose a package or tell us what you need. We will confirm the deliverables, payment schedule and timing in writing, then explain the agreed payment method."
    primaryLabel="Get a quote"
    primaryHref="/contact"
    secondaryLabel="Start with an audit"
    secondaryHref="/digital-audit"
  />
</BaseLayout>
