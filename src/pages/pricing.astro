---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqList from "../components/FaqList.astro";
import {
  auditPricing,
  costFactors,
  domainOffer,
  hourlyPricing,
  hostingBillingNotice,
  hostingPlans,
  monthlyRetainers,
  onceOffEdits,
  pricingPrinciples,
  websiteOffer,
} from "../data/pricing";
import { pricingFaqs } from "../data/faqs";

const description =
  "Straight Up Digital pricing: human-reviewed audits, website services, and reseller hosting from R99/month, with domain registration available as an add-on.";
const formatZar = (amount: number): string =>
  `R${amount.toLocaleString("en-US")}`;
---

<BaseLayout
  title="Pricing"
  description={description}
  canonicalPath="/pricing"
>
  <section class="page-hero">
    <div class="container page-hero__inner">
      <div>
        <p class="kicker">Pricing</p>
        <h1 class="page-hero__title">
          Clear scope. Written quotes. No surprise invoices.
        </h1>
        <div class="page-hero__actions">
          <a class="btn btn--primary" href="/contact">
            Get a quote
            <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
          <a class="btn btn--secondary" href="#hosting-packages">See hosting plans</a>
        </div>
      </div>
      <p class="page-hero__lede">
        Audit and existing website-service rates remain as configured. The
        hosting tiers below are owner-approved reseller offers; the suggested
        .co.za range is indicative. FOSSBilling with Paystack is planned, but
        checkout is not live yet.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="principles-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>01</span> How pricing works</p>
          <h2 class="h2" id="principles-title" style="margin-top: 14px; max-width: 14ch;">
            Three rules, every time.
          </h2>
        </div>
        <p class="lede">
          The quote is not a sales document. It is the agreement about what will
          be done, what it costs and when it will be finished.
        </p>
      </div>

      <div class="pricing-principles">
        {
          pricingPrinciples.map((principle) => (
            <article>
              <h3>{principle.title}</h3>
              <p>{principle.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="factors-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>02</span> What affects cost</p>
          <h2 class="h2" id="factors-title" style="margin-top: 14px; max-width: 14ch;">
            Six things change the number.
          </h2>
        </div>
        <p class="lede">
          None of them are secrets. Knowing them in advance is why the quote can
          be fixed rather than “estimated”.
        </p>
      </div>

      <div class="factor-grid">
        {
          costFactors.map((factor) => (
            <article class="factor">
              <h3>{factor.title}</h3>
              <p>{factor.body}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section ivory" id="packages" aria-labelledby="packages-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker"><span>03</span> Existing rates</p>
          <h2 class="h2" id="packages-title" style="margin-top: 14px;">
            Clear numbers, agreed scope.
          </h2>
        </div>
        <p class="body">
          Audit and website-service rates mirror the existing proposal settings;
          hosting is a separate reseller offer. A written quote confirms scope.
        </p>
      </div>

      <div class="pricing-overview">
        <article class="pricing-overview__card">
          <p class="pricing-label">Business Auditor · human-reviewed audit</p>
          <p class="pricing-overview__price">{formatZar(auditPricing.pricePerMissingPointZar)}<span> per missing point</span></p>
          <p>
            The proposal calculation uses the gap from a maximum score of
            {" "}{auditPricing.maximumScore}: missing points × the rate shown.
            This public website does not run automated live audits.
          </p>
          <a class="link-arrow" href="/digital-audit#request">
            Request an audit
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
          </a>
        </article>
        <article class="pricing-overview__card">
          <p class="pricing-label">Website build</p>
          <p class="pricing-overview__price">{formatZar(websiteOffer.buildOnceOffZar)}<span> once-off</span></p>
          <p>Basic build scope covers up to {websiteOffer.maximumPages} pages.</p>
          <a class="link-arrow" href="/contact">Discuss a website</a>
        </article>
        <article class="pricing-overview__card">
          <p class="pricing-label">Reseller hosting</p>
          <p class="pricing-overview__price">From {formatZar(websiteOffer.hostingMonthlyZar)}<span> / month</span></p>
          <p>Three plans with different storage and email allowances are listed below.</p>
          <a class="link-arrow" href="#hosting-packages">Compare hosting plans</a>
        </article>
        <article class="pricing-overview__card">
          <p class="pricing-label">Hourly work</p>
          <p class="pricing-overview__price">{formatZar(hourlyPricing.rateZar)}<span> / hour</span></p>
          <p>Proposal estimates use a {hourlyPricing.minimumEstimateHours}-hour minimum estimate.</p>
        </article>
      </div>

      <div class="pricing-subsection" id="hosting-packages" aria-labelledby="hosting-packages-title">
        <div class="section-head">
          <div>
            <p class="kicker"><span>04</span> Reseller hosting &amp; domains</p>
            <h3 class="h2" id="hosting-packages-title" style="margin-top: 14px;">Hosting that can grow with your business.</h3>
          </div>
          <p class="body">
            Monthly plans show their storage and email-account allowances. Domain
            registration and renewal are separate annual charges.
          </p>
        </div>
        <div class="package-grid package-grid--retainers">
          {hostingPlans.map((plan) => (
            <article class="package-slot package-slot--retainer">
              <p class="pricing-label">Managed hosting</p>
              <h3>{plan.name}</h3>
              <p class="package-slot__price">{plan.price}<span> / month</span></p>
              <p>{plan.summary}</p>
              <ul class="package-includes">
                {plan.includes.map((item) => <li>{item}</li>)}
              </ul>
              <a class="link-arrow" href="/contact">Ask about this plan</a>
            </article>
          ))}
        </div>
        <p class="pricing-guardrail" style="margin-top: 24px;">
          <strong>Domain registration:</strong> suggested .co.za registration and renewal range: {domainOffer.coZaPrice} {domainOffer.billing}. {domainOffer.note}
        </p>
        <p class="pricing-guardrail">{hostingBillingNotice}</p>
      </div>

      <div class="pricing-subsection">
        <div class="section-head">
          <div>
            <p class="kicker"><span>05</span> Monthly support</p>
            <h3 class="h2" style="margin-top: 14px;">Five bounded retainers.</h3>
          </div>
          <p class="body">
            Retainers are optional support, not a promise of rankings, leads or
            revenue. Agree the monthly deliverables in writing.
          </p>
        </div>
        <div class="package-grid package-grid--retainers">
          {monthlyRetainers.map((plan) => (
            <article class="package-slot package-slot--retainer">
              <p class="pricing-label">Monthly retainer</p>
              <h3>{plan.name}</h3>
              <p class="package-slot__price">{formatZar(plan.priceZarPerMonth)}<span> / month</span></p>
              <ul class="package-includes">
                {plan.includes.map((item) => <li>{item}</li>)}
              </ul>
              <a class="link-arrow" href="/contact">Ask about this retainer</a>
            </article>
          ))}
        </div>
      </div>

      <div class="pricing-subsection">
        <div class="section-head">
          <div>
            <p class="kicker"><span>06</span> Once-off edits</p>
            <h3 class="h2" style="margin-top: 14px;">Small changes, listed plainly.</h3>
          </div>
          <p class="body">These are the existing standard rates for individual website edits.</p>
        </div>
        <div class="edit-rate-grid">
          {onceOffEdits.map((item) => (
            <article class="edit-rate">
              <h4>{item.title}</h4>
              <p>{formatZar(item.priceZar)}</p>
            </article>
          ))}
        </div>
      </div>

      <p class="pricing-guardrail">
        {websiteOffer.guardrail}
      </p>

      <p style="margin-top: 32px;">
        <a class="btn btn--primary btn--on-ivory" href="/contact">
          Discuss your scope
          <svg class="btn__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 12h15M13 6l6 6-6 6"></path></svg>
        </a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="pricing-faq-title">
    <div class="container container--narrow">
      <div class="section-head" style="grid-template-columns: 1fr;">
        <div>
          <p class="kicker"><span>07</span> Questions</p>
          <h2 class="h2" id="pricing-faq-title" style="margin-top: 14px;">
            Before you ask for a quote.
          </h2>
        </div>
      </div>
      <FaqList items={pricingFaqs} />
    </div>
  </section>

  <CtaBand
    title="Tell us the scope. We will put a number on it."
    body="Send the website address and what you want fixed. You will get one written quote with the deliverables, cost and timing."
    primaryLabel="Get a quote"
    primaryHref="/contact"
    secondaryLabel="Start with an audit"
    secondaryHref="/digital-audit"
  />
</BaseLayout>
