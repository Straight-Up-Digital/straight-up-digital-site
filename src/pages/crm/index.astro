<!doctype html>
<html lang="en-ZA">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="no-referrer" />
    <meta name="theme-color" content="#080a09" />
    <title>Private CRM | Straight Up Digital</title>
    <style>
      :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #080a09; color: #f2f4ef; font-synthesis: none; }
      * { box-sizing: border-box; }
      body { margin: 0; min-width: 320px; background: radial-gradient(ellipse at 85% 0%, #142018 0, #080a09 46rem); }
      a { color: #a8ff65; }
      button, input, select, textarea { font: inherit; }
      button { cursor: pointer; }
      .shell { width: min(1120px, calc(100% - 32px)); margin: 0 auto; padding: 28px 0 64px; }
      .topbar { display: flex; justify-content: space-between; align-items: center; gap: 20px; margin-bottom: 32px; }
      .brand { display: flex; align-items: center; gap: 12px; color: #f2f4ef; text-decoration: none; font-weight: 750; letter-spacing: .02em; }
      .mark { width: 34px; height: 34px; display: grid; place-items: center; border-radius: 10px; color: #080a09; background: #a8ff65; font-size: 20px; }
      .eyebrow { color: #a8ff65; font-size: .75rem; font-weight: 750; letter-spacing: .14em; text-transform: uppercase; }
      h1 { margin: 10px 0; font-size: clamp(2rem, 5vw, 3.3rem); line-height: 1.05; letter-spacing: -.04em; }
      h2 { margin: 0 0 14px; font-size: 1.1rem; }
      p { color: #bac3bc; line-height: 1.6; }
      .panel { border: 1px solid #29342c; border-radius: 18px; background: rgba(15, 21, 17, .94); padding: 24px; box-shadow: 0 20px 70px #0003; }
      .login-wrap { max-width: 480px; margin: 54px auto; }
      .grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(320px, .9fr); gap: 18px; align-items: start; }
      .summary { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; margin-bottom: 18px; }
      .metric { padding: 16px; border: 1px solid #29342c; border-radius: 14px; background: #0e1410; }
      .metric strong { display: block; margin-top: 6px; font-size: 1.6rem; }
      .controls { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 14px; }
      .controls input { flex: 1 1 200px; }
      input, select, textarea { width: 100%; border: 1px solid #37443a; border-radius: 10px; background: #080d0a; color: #f2f4ef; padding: 11px 12px; }
      input[type="checkbox"] { width: auto; margin: 0 8px 0 0; vertical-align: middle; }
      textarea { min-height: 105px; resize: vertical; }
      label { display: grid; gap: 6px; color: #c9cfcb; font-size: .88rem; }
      .form-grid { display: grid; gap: 12px; }
      .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .btn { border: 1px solid #52624f; border-radius: 10px; background: #151e17; color: #f2f4ef; padding: 10px 14px; font-weight: 700; }
      .btn-primary { border-color: #a8ff65; background: #a8ff65; color: #101510; }
      .btn:hover { filter: brightness(1.08); }
      .contacts { display: grid; gap: 8px; max-height: 540px; overflow: auto; }
      .contact-item { width: 100%; text-align: left; padding: 13px; border: 1px solid #29342c; border-radius: 12px; background: #0a100c; color: #f2f4ef; }
      .contact-item[aria-current="true"] { border-color: #a8ff65; }
      .contact-item span { display: block; margin-top: 4px; color: #aeb8b0; font-size: .85rem; }
      .row-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
      .activity { border-top: 1px solid #29342c; padding: 12px 0; }
      .activity time { display: block; margin-top: 4px; color: #8d9990; font-size: .8rem; }
      .status { min-height: 1.5em; color: #a8ff65; font-size: .9rem; }
      .muted { color: #97a39a; font-size: .9rem; }
      [hidden] { display: none !important; }
      @media (max-width: 760px) {
        .grid { grid-template-columns: 1fr; }
        .summary { grid-template-columns: repeat(2, 1fr); }
        .shell { width: min(100% - 24px, 600px); padding-top: 18px; }
        .panel { padding: 18px; }
      }
      @media (max-width: 420px) {
        .two-col { grid-template-columns: 1fr; }
        .topbar { align-items: flex-start; }
        .summary { gap: 8px; }
        .metric { padding: 12px; }
      }
    </style>
  </head>
  <body>
    <main class="shell">
      <header class="topbar">
        <a class="brand" href="/" aria-label="Straight Up Digital home">
          <span class="mark" aria-hidden="true">S</span>
          <span>Straight Up Digital <span class="muted">/ Private CRM</span></span>
        </a>
        <a href="/" class="muted">Back to website</a>
      </header>

      <section id="login-panel" class="panel login-wrap" aria-labelledby="login-title">
        <div class="eyebrow">Owner access</div>
        <h1 id="login-title">Sign in to your CRM</h1>
        <p>This private workspace requires the owner password. Do not use a shared or public computer without signing out.</p>
        <form id="login-form" class="form-grid">
          <label for="password">CRM password
            <input id="password" name="password" type="password" autocomplete="current-password" required minlength="1" maxlength="256" />
          </label>
          <button class="btn btn-primary" type="submit">Sign in</button>
        </form>
        <p id="login-status" class="status" role="status" aria-live="polite"></p>
      </section>

      <section id="crm-panel" hidden aria-labelledby="crm-title">
        <div class="row-head">
          <div>
            <div class="eyebrow">Private workspace</div>
            <h1 id="crm-title">Business CRM</h1>
          </div>
          <button id="logout" class="btn" type="button">Sign out</button>
        </div>
        <p>Contact details and notes are private. Marketing permission is recorded separately and starts off.</p>
        <div id="summary" class="summary" aria-label="Pipeline summary"></div>
        <div class="grid">
          <section class="panel" aria-labelledby="contacts-title">
            <div class="row-head">
              <h2 id="contacts-title">Contacts</h2>
              <button id="new-contact" class="btn btn-primary" type="button">Add contact</button>
            </div>
            <div class="controls">
              <input id="search" type="search" aria-label="Search contacts" placeholder="Search business, email or phone" />
              <select id="stage-filter" aria-label="Filter by pipeline stage">
                <option value="">All stages</option>
                <option value="new">New</option>
                <option value="contacted">Contacted</option>
                <option value="quoted">Quoted</option>
                <option value="accepted">Accepted</option>
                <option value="live">Live</option>
                <option value="lost">Lost</option>
              </select>
            </div>
            <div id="contacts" class="contacts" aria-live="polite"></div>
          </section>

          <section class="panel" aria-labelledby="detail-title">
            <h2 id="detail-title">Contact details</h2>
            <form id="contact-form" class="form-grid" hidden>
              <label for="business-name">Business name
                <input id="business-name" name="businessName" maxlength="160" required />
              </label>
              <div class="two-col">
                <label for="first-name">First name
                  <input id="first-name" name="firstName" maxlength="100" />
                </label>
                <label for="surname">Surname
                  <input id="surname" name="surname" maxlength="100" />
                </label>
              </div>
              <div class="two-col">
                <label for="email">Email
                  <input id="email" name="email" type="email" maxlength="200" />
                </label>
                <label for="phone">Phone
                  <input id="phone" name="phone" maxlength="40" />
                </label>
              </div>
              <div class="two-col">
                <label for="town">Town
                  <input id="town" name="town" maxlength="100" />
                </label>
                <label for="sector">Sector
                  <input id="sector" name="sector" maxlength="120" />
                </label>
              </div>
              <label for="website">Website
                <input id="website" name="websiteUrl" type="url" maxlength="300" placeholder="https://example.co.za" />
              </label>
              <div class="two-col">
                <label for="stage">Pipeline stage
                  <select id="stage" name="pipelineStage">
                    <option value="new">New</option>
                    <option value="contacted">Contacted</option>
                    <option value="quoted">Quoted</option>
                    <option value="accepted">Accepted</option>
                    <option value="live">Live</option>
                    <option value="lost">Lost</option>
                  </select>
                </label>
                <label for="follow-up">Next follow-up
                  <input id="follow-up" name="nextFollowUpDate" type="date" />
                </label>
              </div>
              <label for="notes">Private notes
                <textarea id="notes" name="notes" maxlength="4000"></textarea>
              </label>
              <label><span><input id="marketing-consent" name="marketingConsent" type="checkbox" /> Marketing permission recorded</span></label>
              <label for="consent-version">Consent wording/version
                <input id="consent-version" name="consentTextVersion" maxlength="100" placeholder="Required when permission is recorded" />
              </label>
              <div class="controls">
                <button class="btn btn-primary" type="submit">Save contact</button>
                <button id="cancel-contact" class="btn" type="button">Cancel</button>
              </div>
            </form>
            <p id="detail-empty" class="muted">Choose a contact or add a new one.</p>
            <p id="detail-status" class="status" role="status" aria-live="polite"></p>
            <section id="activity-panel" hidden aria-labelledby="activity-title">
              <h2 id="activity-title">Activity timeline</h2>
              <form id="activity-form" class="form-grid">
                <div class="two-col">
                  <label for="activity-type">Type
                    <select id="activity-type" name="eventType">
                      <option value="note">Note</option>
                      <option value="call">Call</option>
                      <option value="whatsapp">WhatsApp</option>
                      <option value="email">Email</option>
                      <option value="meeting">Meeting</option>
                    </select>
                  </label>
                  <label for="activity-direction">Direction
                    <select id="activity-direction" name="direction">
                      <option value="outbound">Outbound</option>
                      <option value="inbound">Inbound</option>
                    </select>
                  </label>
                </div>
                <label for="activity-summary">Summary
                  <textarea id="activity-summary" name="summary" maxlength="1000" required></textarea>
                </label>
                <label for="activity-outcome">Outcome
                  <input id="activity-outcome" name="outcome" maxlength="500" />
                </label>
                <button class="btn btn-primary" type="submit">Add activity</button>
              </form>
              <div id="activities" aria-live="polite"></div>
            </section>
          </section>
        </div>
        <p id="crm-status" class="status" role="status" aria-live="polite"></p>
      </section>
    </main>
    <script>
      import "../../scripts/crm.ts";
    </script>
  </body>
</html>
